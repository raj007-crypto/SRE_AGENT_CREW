# Copy this file to `.env` and fill in values, or export them in your
# shell. main.py calls load_dotenv() on startup, so a `.env` file in the
# project root is picked up automatically.

# ---- LLM (open-source, via a local Ollama server) ----
# Used by agents/root_cause.py and agents/scribe.py. If Ollama isn't
# running, both agents fall back to their mock/template paths.
OLLAMA_MODEL=llama3.2:3b

# ---- Slack approval (scaffold only -- the resume step is NOT implemented) ----
# agents/approval_gate.py posts an Approve/Deny message to Slack when BOTH
# are set; if only one is set it falls back to printing to the terminal.
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=

# ---- LangSmith tracing (optional) ----
# Set LANGSMITH_TRACING=true + LANGSMITH_API_KEY to send traces to
# smith.langchain.com. Read by the langsmith package, not by this codebase.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sre-agent-crew
